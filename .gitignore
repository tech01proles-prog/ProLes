```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# Build outputs
dist/
build/
public/build/
out/
.next/
.nuxt/
.svelte-kit/
output/

# TypeScript/JavaScript
*.tsbuildinfo
*.js.map
*.jsx.map
*.ts.map

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage
coverage/
.nyc_output/
```