```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.tsbuildinfo
target/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.env
.envrc
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.hypothesis/

# Coverage reports
coverage/
*.lcov

# Temporary files
*.tmp
*.temp
*~

# OS generated files
# System files
.DS_Store
Thumbs.db

# Compiled files
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out

# Archives
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.rar
*.7z
*.tar.zst

```