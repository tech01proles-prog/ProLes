```
# Kotlin/Android build artifacts
*.class
*.jar
*.war
*.ear
*.apk
*.aar

# Build directories
build/
.gradle/
target/

# IDE specific
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Compiled Python (if any Python present)
*.pyc
__pycache__/

# Dependencies
node_modules/
venv/
.venv/
.libs/

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
*.env.*

# Coverage reports
coverage/
htmlcov/
.coverage

# Python cache
.mypy_cache/
.pytest_cache/

# Distribution artifacts
dist/
```
