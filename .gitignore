```
# Kotlin/Android build artifacts
*.class
*.jar
*.war
*.aar
*.apk
*.dex

# Gradle
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio
*.iml
*.iws
*.ipr
.idea/
captures/
*.keystore
*.db

# Temporary files
*.tmp
*.temp
*.log

# Environment
.env
.env.local
.env.*

# Coverage reports
coverage/
*.lcov
*.profdata

# Testing
*.dump
*.dmp

# Compiled Python files (if any Python scripts exist in the project)
*.pyc
__pycache__/
*.pyo
*.pyd

# Byte-compiled Java files (if mixed with Kotlin)
*.class

# C/C++ compiled files (if native code exists)
*.o
*.obj
*.so
*.dll
*.a
*.lib
*.exe

# Distribution / packaging
dist/
target/
*.tar.gz
*.zip
*.tar
*.gz
```